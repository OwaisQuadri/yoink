{
  "name": "yoink",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension to detect and download video streams from almost any website.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "helper:install": "node scripts/install-native-host.mjs",
    "helper:uninstall": "node scripts/uninstall-native-host.mjs",
    "cli:install": "node scripts/install-cli.mjs",
    "cli:uninstall": "node scripts/uninstall-cli.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.287",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "playwright": "^1.62.1"
  }
}
